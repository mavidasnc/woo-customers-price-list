msgid "CSV File"
msgstr "File CSV"

#: admin/views/import-page.php:187
msgid "Accepted formats: .csv, .txt (UTF-8 or Windows-1252 encoding, comma or semicolon delimiter)."
msgstr "Formati accettati: .csv, .txt (codifica UTF-8 o Windows-1252, delimitatore virgola o punto e virgola)."

#: admin/views/import-page.php:200
msgid "CSV URL"
msgstr "URL CSV"

#: admin/views/import-page.php:212
msgid "The URL must be publicly accessible. HTTPS is strongly recommended."
msgstr "L'URL deve essere pubblicamente accessibile. HTTPS è fortemente consigliato."

#: admin/views/import-page.php:224
msgid "Row limit"
msgstr "Limite righe"

