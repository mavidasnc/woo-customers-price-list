{
  "name": "woo-dynamic-pricelist-pro",
  "version": "1.3.3",
  "description": "Build tools for WooCommerce Dynamic Price List Pro",
  "private": true,
  "scripts": {
    "copy-vendor": "node scripts/copy-vendor.js",
    "build": "npm run copy-vendor && sass admin/scss/wdplp-admin.scss:admin/css/wdplp-admin.css public/scss/wdplp-public.scss:public/css/wdplp-public.css --style=expanded --no-source-map",
    "watch": "sass --watch admin/scss/wdplp-admin.scss:admin/css/wdplp-admin.css public/scss/wdplp-public.scss:public/css/wdplp-public.css --style=expanded --no-source-map",
    "build:prod": "npm run copy-vendor && sass admin/scss/wdplp-admin.scss:admin/css/wdplp-admin.css public/scss/wdplp-public.scss:public/css/wdplp-public.css --style=compressed --no-source-map"
  },
  "devDependencies": {
    "sass": "^1.77.0",
    "select2": "^4.1.0-rc.0"
  }
}
