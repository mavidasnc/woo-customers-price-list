{
  "name": "woo-customers-price-list",
  "version": "2.0.0",
  "description": "Build tools for Customers Price List for WooCommerce",
  "private": true,
  "scripts": {
    "copy-vendor": "node scripts/copy-vendor.js",
    "build": "npm run copy-vendor && sass admin/scss/wcpl-admin.scss:admin/css/wcpl-admin.css public/scss/wcpl-public.scss:public/css/wcpl-public.css --style=expanded --no-source-map",
    "watch": "sass --watch admin/scss/wcpl-admin.scss:admin/css/wcpl-admin.css public/scss/wcpl-public.scss:public/css/wcpl-public.css --style=expanded --no-source-map",
    "build:prod": "npm run copy-vendor && sass admin/scss/wcpl-admin.scss:admin/css/wcpl-admin.css public/scss/wcpl-public.scss:public/css/wcpl-public.css --style=compressed --no-source-map"
  },
  "devDependencies": {
    "sass": "^1.77.0",
    "select2": "^4.1.0-rc.0"
  }
}
